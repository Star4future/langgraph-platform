# Heavy docs and internal files not needed at runtime
CEO_PLAN.md
CHANGELOG.md
EXPERIENCE-LOG.md
EXPERT-REVIEW.md
PROGRESS.md
REPORT.md
STATE.json

# Internal artifacts
artifacts/

# Tests don't run on Vercel
tests/

# Eval datasets are large; only the harness code needs to be present —
# except the education smoke set, which the web console's /evals page
# reads at build time (and /api/eval's dataset whitelist can then serve).
# Glob form on purpose: excluding the directory itself would make the
# re-include unreachable (gitignore semantics — a file under an excluded
# directory cannot be re-included).
eval/datasets/*
!eval/datasets/education_30.jsonl

# Scripts only needed locally
scripts/

# Git internals
.git/
